# ==============================================================
# CareLoop AI: Node.js Express Backend Service (.env.example)
# ==============================================================

PORT=5000
NODE_ENV=production

# JWT Authentication
JWT_SECRET=careloop-secure-enterprise-jwt-token-secret-replace-in-production

# Supabase PostgreSQL Database Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# Python Scikit-Learn Random Forest Microservice Endpoint
ML_SERVICE_URL=http://localhost:8000

# Google Gemini API Key for Simple-Language Care Gap Explanations
# (Strictly non-diagnostic administrative workflow suggestions)
GEMINI_API_KEY=your_gemini_api_key_here
